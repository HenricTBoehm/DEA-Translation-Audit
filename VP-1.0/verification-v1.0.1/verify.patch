+def compare_rp(actual, expected, exit_code):
+    filenames = ("remediation-results.json", "countermodels.json")
+    result = {"exit": exit_code, "semantic_equal": False}
+    if exit_code or not all((actual / name).is_file() for name in filenames):
+        return result
+    for name in filenames:
+        result[name] = {
+            "byte_equal": (actual / name).read_bytes() == (expected / name).read_bytes()
+        }
+    current, archived = [
+        json.loads((directory / filenames[0]).read_bytes()) for directory in (actual, expected)
+    ]
+    expected_version = archived["meta"].get("python")
+    current_version = current["meta"].get("python")
+    current["meta"]["python"] = expected_version
+    result["meta.python"] = {"archived": expected_version, "actual": current_version}
+    result[filenames[0]]["semantic_equal"] = (
+        isinstance(expected_version, str) and isinstance(current_version, str)
+        and canonical_json(current) == canonical_json(archived)
+    )
+    result[filenames[1]]["semantic_equal"] = canonical_json(
+        json.loads((actual / filenames[1]).read_bytes())
+    ) == canonical_json(json.loads((expected / filenames[1]).read_bytes()))
+    result["semantic_equal"] = all(result[name]["semantic_equal"] for name in filenames)
+    return result
+
+
+def canonical_json(value):
+    return json.dumps(value, sort_keys=True, separators=(",", ":"))
+
