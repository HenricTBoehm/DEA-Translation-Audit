+def _rbac_state_guard(f):
+    """[VP-1] An image whose RH* is not a partial order is not an RBAC state (Li p.10; RSL99 p.47).
+    Report it as a distinct observable so the comparison fails instead of silently closing a cycle."""
+    def g(*a, **k):
+        try:
+            return f(*a, **k)
+        except ValueError:
+            return frozenset(["INVALID_TARGET_STATE"])
+    g.__name__, g.__doc__ = f.__name__, f.__doc__
+    return g
+
